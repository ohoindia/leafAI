NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=leaf_ai
DB_USER=leafapp
DB_PASSWORD=change_me_now
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_char_secret
UPLOAD_ENCRYPTION_KEY=replace_with_64_hex_characters
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080
TRUST_PROXY=0
DB_CONNECTION_LIMIT=10
DB_SSL=false
# Required PEM CA bundle when DB_SSL=true; use Secrets Manager in Lambda.
# DB_SSL_CA=
# UPLOAD_BUCKET=your-private-bucket
MAX_UPLOAD_BYTES=4194304

# HTTPS email delivery webhook: receives { to, subject, token, expiresInMinutes }.
# Authenticate with the Bearer secret below. Send token as a copyable recovery code.
RESET_EMAIL_WEBHOOK_URL=
RESET_EMAIL_WEBHOOK_SECRET=

# Server-only data.gov.in API key for AGMARKNET mandi reports
DATA_GOV_IN_API_KEY=
# Enable only on a continuously running server; Lambda uses the SAM schedule.
MARKET_SCHEDULER_ENABLED=false

# Razorpay credentials and plan IDs are stored in ConfigSecrets.
# ConfigValues.EnableSubscription controls paid feature access. See RAZORPAY_SETUP.md.
