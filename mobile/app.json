{
  "expo": {
    "name": "Krishi Karshak",
    "slug": "leafcare-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a leaf photo for plant health analysis.",
          "cameraPermission": "Photograph a leaf for plant health analysis.",
          "microphonePermission": false
        }
      ],
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leafcareai.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.leafcareai.app",
      "adaptiveIcon": {
        "backgroundColor": "#edf8ff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "leafcare",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba67d2e2-a2c4-4411-b873-8ad695511eaf"
      }
    },
    "owner": "reachkarun"
  }
}
