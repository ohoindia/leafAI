{
  "expo": {
    "name": "Krishi Karshak",
    "slug": "leafcare-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/krishi-farmer-logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/krishi-farmer-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#edf8ff"
        }
      ],
      "./plugins/withFertilizerApp.cjs",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or a leaf photo for plant health analysis.",
          "cameraPermission": "Take your profile photo or photograph a leaf for plant health analysis.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to show local weather, market prices, and identify your district for agriculture officer contacts."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leafcareai.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.leafcareai.app",
      "adaptiveIcon": {
        "backgroundColor": "#edf8ff",
        "foregroundImage": "./assets/krishi-farmer-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/krishi-farmer-logo.png"
    },
    "scheme": "leafcare",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d83e04ec-bbb3-400e-a737-59c276ce229a"
      }
    },
    "owner": "ohoindia"
  }
}
